{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5",
          "limit": {
            "context": 400000,
            "output": 8192
          },
          "cost": {
            "input": 1.65,
            "output": 13.2
          }
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    }
  }
  ,
  "mcp": {
    "servers": {
      "search_course_materials": {
        "type": "local",
        "command": [
          ".venv/bin/python",
          "practices/practice_04/mcp/search_course_materials/mcp_server.py"
        ],
        "cwd": ".",
        "environment": {}
      }
    }
  }
}
